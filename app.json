{
  "expo": {
    "name": "Kwikroutine",
    "slug": "kwikroutine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kwikroutine.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kwikroutine.app",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "onnxruntime-react-native",
      "./plugins/with-kwikroutine.cjs",
      "./plugins/with-laya-model.cjs",
      "expo-router"
    ],
    "scheme": "kwikroutine",
    "experiments": {
      "baseUrl": ""
    },
    "backgroundColor": "#0C0C0D",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f847e76e-3b86-4420-8ade-0cc1e0657106"
      }
    }
  }
}
